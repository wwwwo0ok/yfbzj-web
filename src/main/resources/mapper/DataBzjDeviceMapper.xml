<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.project.mapper.DataBzjDeviceMapper">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.company.project.entity.DataBzjDeviceEntity" id="dataBzjDeviceMap">
        <result property="lotId" column="lot_id"/>
        <result property="deptId" column="dept_id"/>
        <result property="username" column="username"/>
        <result property="address" column="address"/>
        <result property="telephone" column="telephone"/>
        <result property="deviceName" column="device_name"/>
        <result property="nickname" column="nickname"/>
        <result property="productKey" column="product_key"/>
        <result property="deviceModified" column="device_modified"/>
        <result property="deviceStatus" column="device_status"/>
        <result property="deviceSecret" column="device_secret"/>
        <result property="deviceType" column="device_type"/>
        <result property="latestX" column="latest_x"/>
        <result property="latestY" column="latest_y"/>
        <result property="baiduX" column="baidu_x"/>
        <result property="baiduY" column="baidu_y"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>



	<select id="getSelect" 
        parameterType="com.company.project.dto.DeviceAndSaleQueryDTO" 
        resultMap="dataBzjDeviceMap">
	    SELECT
	        sale.buyer AS username,
	        sale.address_info AS address,
	        sale.phone AS telephone,
	        device.*
	    FROM
	        data_bzj_device device
	    LEFT JOIN
	        data_sale sale ON device.device_name = sale.product_code
    	<where>
	        <!-- 买家（非空判断） -->
	        <if test="query.buyer != null and query.buyer != ''">
	            AND sale.buyer LIKE CONCAT('%', #{query.buyer}, '%')
	        </if>
	        
	        <!-- 联系电话（非空判断） -->
	        <if test="query.phone != null and query.phone != ''">
	            AND sale.phone = #{query.phone}
	        </if>
	        
	        <!-- 省（非空判断） -->
	        <if test="query.provinceId != null and query.provinceId != ''">
	            AND sale.province_id = #{query.provinceId}
	        </if>
	        
	        <!-- 市（非空判断） -->
	        <if test="query.cityId != null and query.cityId != ''">
	            AND sale.city_id = #{query.cityId}
	        </if>
	        
	        <!-- 区（非空判断） -->
	        <if test="query.countryId != null and query.countryId != ''">
	            AND sale.country_id = #{query.countryId}
	        </if>
	        
	        <!-- 设备名称（非空判断，支持模糊查询） -->
	        <if test="query.deviceName != null and query.deviceName != ''">
	            AND device.device_name LIKE CONCAT('%', #{query.deviceName}, '%')
	        </if>
	        
	        <!-- 设备状态（非空判断） -->
	        <if test="query.deviceStatus != null and query.deviceStatus != ''">
	            AND device.device_status = #{query.deviceStatus}
	        </if>
	        
	        <!-- 设备类型（非空判断） -->
	        <if test="query.deviceType != null and query.deviceType != ''">
	            AND device.device_type = #{query.deviceType}
	        </if>
    	</where>
	</select>

	<select id="pointMap" parameterType="com.company.project.entity.DataBzjDeviceEntity" resultType="java.util.Map">
    SELECT 
        -- 在线数量（根据 deviceTypeList 过滤 device_type）
        (SELECT COUNT(*) 
         FROM data_bzj_device dbd 
         WHERE dbd.del_flag = 0 
         AND device_status = 'ONLINE'
         <if test="query.deviceTypeList != null and query.deviceTypeList.size() > 0">
             AND dbd.device_type IN 
             <foreach collection="query.deviceTypeList" item="type" open="(" separator="," close=")">
                 #{type}
             </foreach>
         </if>
        ) AS online,

        -- 离线数量（根据 deviceTypeList 过滤 device_type）
        (SELECT COUNT(*) 
         FROM data_bzj_device dbd 
         WHERE dbd.del_flag = 0 
         AND device_status = 'OFFLINE'
         <if test="query.deviceTypeList != null and query.deviceTypeList.size() > 0">
             AND dbd.device_type IN 
             <foreach collection="query.deviceTypeList" item="type" open="(" separator="," close=")">
                 #{type}
             </foreach>
         </if>
        ) AS offline,

        -- 监控器数量（根据 deviceStatusList 过滤 device_status）
        (SELECT COUNT(*) 
         FROM data_bzj_device dbd 
         WHERE dbd.del_flag = 0 
         AND dbd.device_type = '1' 
         <if test="query.deviceStatusList != null and query.deviceStatusList.size() > 0">
             AND dbd.device_status IN 
             <foreach collection="query.deviceStatusList" item="status" open="(" separator="," close=")">
                 #{status}
             </foreach>
         </if>
        ) AS jkq,

        -- 播种机数量（根据 deviceStatusList 过滤 device_status）
        (SELECT COUNT(*) 
         FROM data_bzj_device dbd 
         WHERE dbd.del_flag = 0 
         AND dbd.device_type = '2' 
         <if test="query.deviceStatusList != null and query.deviceStatusList.size() > 0">
             AND dbd.device_status IN 
             <foreach collection="query.deviceStatusList" item="status" open="(" separator="," close=")">
                 #{status}
             </foreach>
         </if>
        ) AS dq
</select>


</mapper>